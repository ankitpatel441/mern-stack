<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Post Details</title>

    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <div class="show-container">
        <h1>📄 Post Details</h1>

        <div class="user-card">
            <h2 class="username">@<%= post.username %></h2>
        </div>

        <div class="content-card">
            <h3>Content</h3>
            <p><%= post.content %></p>
        </div>

        <div class="show-actions">
            <a href="/posts" class="back-btn">
                ⬅ Back to Posts
            </a>

            <a href="/posts/<%= post.id %>/edit" class="edit-btn">
                ✏️ Edit
            </a>
        </div>
    </div>

</body>
</html>